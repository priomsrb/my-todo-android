<?xml version="1.0" encoding="utf-8"?>
<!--
  The "one list" widget. It asks which list to show before it is placed, hence android:configure.

  updatePeriodMillis is the only way to notice a file edited outside the app while the home screen
  is showing; in-app edits push an update straight away and do not wait for it. Thirty minutes is
  the shortest the system actually honours.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:configure="dev.shafqat.mytodo.widget.ListWidgetConfigActivity"
    android:description="@string/list_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/list_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
